#DIRECCIÓN Y PUERTO DEL BACKEND DE MICRO SERVICIOS NATS
NEXT_PUBLIC_BACKEND_HOST=192.168.2.YYY
NEXT_PUBLIC_BACKEND_PORT=3000

#URL Y PUERTO DEL FRONTEND ACTUAL
NEXT_PUBLIC_FRONTEND_HOST=192.168.2.YYY
NEXT_PUBLIC_FRONTEND_PORT=3001

# DEPLOY ENV prod | dev | test
NEXT_PUBLIC_DEPLOY_ENV=prod
# Configuracion de servidor para el BFF OIDC
GATEWAY_INTERNAL_URL=http://localhost:3000
HUB_PUBLIC_ORIGIN=http://localhost:3001
AUTH_COOKIE_SECURE=false
AUTH_PENDING_TTL_SECONDS=600

# Herramienta primaria del Hub, disponible solo en el servidor
AUTH_TOOL_KEY=hub
