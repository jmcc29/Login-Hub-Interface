# Ambiente visible por la interfaz actual.
NEXT_PUBLIC_DEPLOY_ENV=dev

# URL interna del Gateway usada únicamente por el servidor Next.js.
GATEWAY_INTERNAL_URL=http://gateway-service-dev:3000

# Origen público del Hub usado para redirecciones seguras.
HUB_PUBLIC_ORIGIN=http://localhost:3001

# Define si las cookies SID deben enviarse exclusivamente mediante HTTPS.
AUTH_COOKIE_SECURE=false

# Vigencia del binding temporal del flujo OIDC, en segundos.
AUTH_PENDING_TTL_SECONDS=600

# Clave fija del Hub reconocida por Auth-Service.
AUTH_TOOL_KEY=hub

# Orígenes públicos seleccionados por el endpoint del servidor de lanzamiento.
BENEFICIARY_PUBLIC_ORIGIN=http://localhost:3002
SALES_PUBLIC_ORIGIN=http://localhost:3003
COLLECTIONS_PUBLIC_ORIGIN=http://localhost:3004
